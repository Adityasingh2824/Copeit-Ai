VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_ASK_COPEIT_MODE=offline
VITE_TURNSTILE_SITE_KEY=
# Public Sentry project DSN only; never put an auth token, API key, or source text in Vite variables.
VITE_SENTRY_DSN=
VITE_RELEASE=

# Server-only Edge Function secrets (do not prefix with VITE_ or put values here):
# GEMINI_API_KEY, GEMINI_MODEL, GEMINI_EMBEDDING_MODEL,
# COPEIT_ALLOWED_ORIGINS, COPEIT_MIN_VECTOR_SIMILARITY, COPEIT_RETRIEVAL_LIMIT

